generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String            @id @default(uuid())
  name           String
  phone          String            @unique
  email          String            @unique
  city           String            @default("Jakarta Selatan")
  avatarUrl      String?
  role           String            @default("USER") // USER | ADMIN | CS
  phoneVerified  Boolean           @default(false)
  kycStatus      String            @default("UNVERIFIED") // UNVERIFIED | PENDING_REVIEW | VERIFIED | REJECTED
  createdAt      DateTime          @default(now())
  
  kycDocument    KycDocument?
  addresses      Address[]
  bankAccounts   BankAccount[]
  wishlists      Wishlist[]
  cartItems      CartItem[]
  orders         Order[]
  consignments   ConsignmentItem[]
  payouts        Payout[]
  disputes       DisputeReport[]
}

model OtpVerification {
  id         String   @id @default(uuid())
  target     String   // Nomor HP / Email
  otpCode    String   // 6 digit kode
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model KycDocument {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullNameKtp     String
  nikNumber       String?
  maskedNik       String
  ktpImageUrl     String
  ktpFileSize     String   @default("1.8 MB")
  selfieImageUrl  String
  selfieFileSize  String   @default("2.1 MB")
  status          String   @default("PENDING_REVIEW") // PENDING_REVIEW | VERIFIED | REJECTED
  rejectionReason String?
  uploadedAt      DateTime @default(now())
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   // Rumah | Kantor | Kos
  recipientName String
  phone         String
  fullAddress   String
  city          String
  postalCode    String   @default("12810")
  isPrimary     Boolean  @default(false)
  orders        Order[]
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String   // BCA | Mandiri | BRI | GoPay
  accountNumber String
  accountHolder String
  isPrimary     Boolean  @default(false)
}

model Product {
  id                String     @id @default(uuid())
  code              String     @unique // e.g. K2-0842
  slug              String     @unique
  consignmentItemId String?
  sellerId          String?
  brand             String
  name              String
  subtitle          String
  category          String     // KEYBOARD | MOUSE | HEADSET | MONITOR | ACCESSORIES
  condition         String     // SANGAT_BAIK | BAIK
  usageDuration     String
  switchOrVariant   String
  completeness      String
  description       String
  defectNotes       String
  price             Int
  originalNewPrice  Int
  stock             Int        @default(1)
  location          String     @default("Jakarta Selatan")
  rating            Float      @default(5.0)
  soldCount         Int        @default(0)
  isVerifiedByTeam  Boolean    @default(true)
  images            String     // JSON string array
  status            String     @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD
  createdAt         DateTime   @default(now())
  
  orders            Order[]
  wishlists         Wishlist[]
  cartItems         CartItem[]
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id                 String          @id @default(uuid())
  orderCode          String          @unique // format GRL-YYYYMMDD-XXXX
  buyerId            String
  buyer              User            @relation(fields: [buyerId], references: [id])
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  addressId          String
  address            Address         @relation(fields: [addressId], references: [id])
  itemPrice          Int
  shippingCourier    String          @default("JNE REG")
  shippingCost       Int             @default(18000)
  shippingProtection Int             @default(5000)
  serviceFee         Int             @default(2500)
  totalAmount        Int
  paymentMethod      String          @default("BCA_VA") // BCA_VA | QRIS
  vaNumber           String?
  buyerNote          String?
  trackingNumber     String          @default("JNE2201040842")
  escrowStatus       String          @default("HELD_BY_HINGO") // AWAITING_PAYMENT | HELD_BY_HINGO | RELEASED_TO_SELLER | REFUNDED | DISPUTED
  orderStatus        String          @default("DELIVERED_CHECKING") // UNPAID | PAID_PACKING | SHIPPED | DELIVERED_CHECKING | COMPLETED | COMPLAINT
  inspectionDeadline String          @default("48 jam setelah paket tiba")
  createdAt          DateTime        @default(now())
  
  timeline           OrderTimeline[]
  disputes           DisputeReport[]
  payouts            Payout[]
}

model OrderTimeline {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stepOrder     Int
  title         String
  description   String
  timestampText String
  isCompleted   Boolean  @default(false)
}

model DisputeReport {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User     @relation(fields: [buyerId], references: [id])
  reasonCategory String   // DEFECT | FUNCTION_ISSUE | MISSING_ITEM | NOT_AS_DESCRIBED
  description    String
  evidenceUrls   String   // JSON string array
  status         String   @default("OPEN") // OPEN | RESOLVED_REFUND | RESOLVED_RELEASE
  createdAt      DateTime @default(now())
}

model ConsignmentItem {
  id                       String                @id @default(uuid())
  code                     String                @unique // format HG-YYMMDD-XXX
  sellerId                 String
  seller                   User                  @relation(fields: [sellerId], references: [id])
  category                 String                // KEYBOARD | MOUSE | HEADSET | MONITOR | ACCESSORIES
  brandModel               String
  variantSpec              String
  usageDuration            String
  additionalSpecs          String
  currentCondition         String
  defectDetails            String
  completeness             String
  photos                   String                // JSON array
  expectedPrice            Int
  proposedPrice            Int?
  consignmentFeePercent    Int                   @default(8)
  consignmentFeeAmount     Int?
  adminHandlingFee         Int                   @default(19000)
  estimatedNetPayout       Int?
  actualNetPayout          Int?
  originCity               String                @default("Jakarta")
  handoverMethod           String
  inboundCourier           String?
  inboundTrackingNumber    String?
  stage                    String                @default("ONLINE_CHECK") // DRAFT | ONLINE_CHECK | REVISION_NEEDED | ONLINE_CHECK_PASSED | SHIPPING_TO_HINGO | RECEIVED_AT_HINGO | INSPECTION_COMPLETED | PRICE_AGREED_MARKETING | SOLD_SHIPPING_TO_BUYER | PAYOUT_COMPLETED | RETURN_DISCUSSED
  actionActor              String                @default("HINGO") // SELLER | HINGO | SELLER_AND_HINGO | COMPLETED
  badgeLabel               String
  statusSummary            String
  inspectionSpecs          String?
  inspectionFunctionTest   String?
  inspectionConditionDefect String?
  inspectionCompleteness   String?
  inspectedAt              DateTime?
  updatedAt                DateTime              @updatedAt
  
  timeline                 ConsignmentTimeline[]
  payouts                  Payout[]
}

model ConsignmentTimeline {
  id             String          @id @default(uuid())
  consignmentId  String
  consignment    ConsignmentItem @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  stepOrder      Int
  title          String
  description    String
  timestampText  String
  state          String          // COMPLETED | CURRENT | UPCOMING
}

model Payout {
  id              String           @id @default(uuid())
  sellerId        String
  seller          User             @relation(fields: [sellerId], references: [id])
  consignmentId   String?
  consignment     ConsignmentItem? @relation(fields: [consignmentId], references: [id])
  orderId         String?
  order           Order?           @relation(fields: [orderId], references: [id])
  amount          Int
  bankName        String           @default("BCA")
  accountNumber   String           @default("1234567890")
  status          String           @default("PENDING_ESCROW") // PENDING_ESCROW | DISBURSED
  transferProofUrl String?
  disbursedAt     DateTime?
  createdAt       DateTime         @default(now())
}

model ChatThread {
  id               String        @id @default(uuid())
  userId           String?
  type             String        @default("PRODUCT_ADMIN") // PRODUCT_ADMIN | CS_SUPPORT | SYSTEM_INFO
  title            String
  agentName        String?
  ticketCode       String?
  relatedProductId String?
  relatedOrderId   String?
  updatedAt        DateTime      @updatedAt
  
  messages         ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(uuid())
  threadId      String
  thread        ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId      String?
  senderRole    String      @default("USER") // USER | ADMIN | CS
  senderName    String?
  content       String
  timeLabel     String?
  attachmentUrl String?
  isRead        Boolean     @default(true)
  createdAt     DateTime    @default(now())
}
