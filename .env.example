# ==============================================================================
# HINGGO ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env.local untuk pengembangan lokal,
# atau masukkan variabel-variabel ini ke dashboard Vercel (Settings > Environment Variables).
# JANGAN PERNAH menaruh nilai rahasia asli di dalam file ini.
# ==============================================================================

# 1. SUPABASE (Wajib)
# URL instance Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci anon / publishable Supabase (aman dipakai di browser untuk akses data publik dengan RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Kompatibilitas alternatif nama key (opsional, jika menggunakan format publishable key baru)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# 2. AUTENTIKASI & SESI (Wajib)
# Kunci rahasia acak untuk menandatangani cookie JWT session pengguna (minimal 32 karakter)
SESSION_SECRET=your-random-32-character-session-secret

# 3. PENGIRIMAN OTP EMAIL (Opsional / Diperlukan untuk alur OTP email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Hingo Official <your-email@gmail.com>"

# 4. PENGIRIMAN OTP WHATSAPP (Opsional / Diperlukan untuk alur OTP WhatsApp via Fonnte)
FONNTE_TOKEN=your-fonnte-token
